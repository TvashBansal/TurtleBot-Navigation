{
  "name": "TurtleBot-Navigation - MuJoCo (Debian Python 3.11)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteEnv": {
    "MUJOCO_GL": "osmesa",
    "MPLBACKEND": "Agg",
    "LIBGL_ALWAYS_SOFTWARE": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
